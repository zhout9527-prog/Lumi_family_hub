# Copy to .env and replace every CHANGE_ME value before Docker deployment.
FAMILYHUB_DATA_ROOT=D:/FamilyHub
FAMILYHUB_PORT=2521
FAMILYHUB_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://tauri.localhost,https://tauri.localhost
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

FAMILYHUB_SEED_DEMO=true
FAMILYHUB_DEMO_CHILD_PASSWORD=CHANGE_ME_CHILD_PASSWORD
FAMILYHUB_DEMO_GUARDIAN_PASSWORD=CHANGE_ME_GUARDIAN_PASSWORD
FAMILYHUB_DEMO_OPERATOR_PASSWORD=CHANGE_ME_OPERATOR_PASSWORD

FAMILYHUB_DIRECT_DOWNLOAD_ENABLED=false
FAMILYHUB_UPDATE_MANIFEST_PATH=updates/manifest.json
FAMILYHUB_NIGHTLY_START_HOUR=1
FAMILYHUB_NIGHTLY_END_HOUR=6
FAMILYHUB_MIN_FREE_RATIO=0.20
