{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lumi Server",
  "version": "1.4.6",
  "identifier": "cn.lumi.familyhub.server",
  "build": {
    "frontendDist": "../dist-server",
    "devUrl": "http://127.0.0.1:4174",
    "beforeDevCommand": "npm run dev:server -- --host 127.0.0.1 --port 4174",
    "beforeBuildCommand": "npm run build:server"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lumi Server",
        "width": 1440,
        "height": 980,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
